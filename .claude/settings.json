{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --check)",
      "Bash(git diff --cached)",
      "Bash(git diff --cached --stat)",
      "Bash(git diff --cached --check)",
      "Bash(git log)",
      "Bash(git show)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v)",

      "Bash(uv sync)",
      "Bash(uv sync --locked)",
      "Bash(uv run ruff format --check .)",
      "Bash(uv run ruff check .)",
      "Bash(uv run mypy src/logrhythm_sdk)",
      "Bash(uv run pytest)",
      "Bash(uv run pre-commit run *)",
      "Bash(uv build)"
    ],
    "ask": [
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock --upgrade *)"
    ],
    "deny": [
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(git clean -x *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git commit --amend *)",
      "Bash(git commit * --amend *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete --force *)",
      "Bash(git rebase *)",
      "Bash(git checkout -- .)",
      "Bash(git checkout -- . *)",
      "Bash(git restore .)",
      "Bash(git restore . *)",
      "Bash(git restore --source *)",
      "Bash(git restore * --source *)",
      "Bash(git tag -d *)",
      "Bash(git tag --delete *)",
      "Bash(git push --delete *)",
      "Bash(git push origin --delete *)",
      "Bash(git push * --delete *)",
      "Bash(* --no-verify *)",
      "Bash(* --no-verify)",
      "Bash(git commit --no-verify)",
      "Bash(git push --no-verify)",

      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(credentials*)",
      "Read(secrets*)",
      "Read(token)",
      "Read(token.txt)",
      "Read(token.json)",
      "Read(*.token)",
      "Read(*_token.txt)",
      "Read(*_token.json)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(*.pem)",
      "Edit(*.key)",
      "Edit(*.p12)",
      "Edit(*.pfx)",
      "Edit(credentials*)",
      "Edit(secrets*)",
      "Edit(token)",
      "Edit(token.txt)",
      "Edit(token.json)",
      "Edit(*.token)",
      "Edit(*_token.txt)",
      "Edit(*_token.json)",
      "Edit(.claude/settings.local.json)"
    ]
  }
}
